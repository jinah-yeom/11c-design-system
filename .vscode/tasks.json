{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🎨 Figma Socket",
      "type": "shell",
      "command": "bunx cursor-talk-to-figma-socket",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "📦 Git Commit & Push",
      "type": "shell",
      "command": "git add . && git commit -m '${input:commitMessage}' && git push",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "커밋 메시지를 입력하세요",
      "default": "update"
    }
  ]
}